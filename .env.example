# ---- Google Cloud (ADC or the service-account key in ./secrets) ----
GOOGLE_CLOUD_PROJECT=onehorizon-494120
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/careplus-agent.json   # auto-detected if present
FIRESTORE_DATABASE=careplus
EVIDENCE_BUCKET=onehorizon-494120-careplus-evidence

# ---- Models ----
OPENAI_API_KEY=
COORDINATOR_MODEL=gpt-5.6-luna
FAST_MODEL=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.1-flash-lite
TXGEMMA_ENDPOINT_ID=            # Vertex AI endpoint id for txgemma-2b-predict (Model Garden)
TXGEMMA_DEDICATED_DNS=          # dedicated endpoint DNS from `gcloud ai endpoints describe`
TXGEMMA_LOCATION=us-central1

# ---- Slack (exception console). Socket Mode → no public URL needed ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...        # for scripts/slack-bot.ts (Socket Mode); create app from slack-app-manifest.yaml
SLACK_SIGNING_SECRET=
SLACK_TRIAGE_CHANNEL=C0123456789

# ---- Patient messaging (optional; virtual phone is used otherwise) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Calendar ----
CLINIC_CALENDAR_ID=             # left empty → created on first use and shared with CALENDAR_SHARE_WITH
CALENDAR_SHARE_WITH=you@example.com

# ---- Store: memory (dev, persists to .careplus/store.json) | firestore ----
STORE_BACKEND=memory

# ---- Behaviour ----
CAREPLUS_DRY_RUN=false          # true → calendar/slack/sms simulated
CAREPLUS_DEBUG=false
PUBLIC_BASE_URL=http://localhost:3000
